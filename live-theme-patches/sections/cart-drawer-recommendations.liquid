{% comment %}
  Rendered only via the Product Recommendations API (routes.product_recommendations_url
  with ?section_id=cart-drawer-recommendations&product_id=...). Not used as a standalone
  section anywhere in the theme — assets/cart-recommendations.js fetches this URL and
  extracts .cart-drawer-recommendations__results into the cart drawer placeholder.

  Layout (direction, sizing, overflow) is controlled entirely by CSS classes
  in snippets/cart-drawer.liquid's <style> block — horizontal swipe strip on
  mobile, vertical sidebar on desktop, same markup either way. Nothing here
  sets display/flex-direction/width inline, so it never fights those rules.
{% endcomment %}
<div class="cart-drawer-recommendations__results">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    {%- for product in recommendations.products limit: 4 -%}
      <div
        class="cart-drawer-recommendations__item"
        style="display:flex;flex-direction:column;gap:3px;border:1px solid rgba(0,0,0,0.08);border-radius:6px;padding:5px;overflow:hidden;"
      >
        <a href="{{ product.url }}" style="display:block;width:44px;margin:0 auto;">
          {%- if product.featured_image -%}
            {{
              product.featured_image
              | image_url: width: 88
              | image_tag:
                loading: 'lazy',
                width: 44,
                height: 44,
                style: 'width:44px;height:44px;aspect-ratio:1/1;object-fit:cover;border-radius:4px;display:block;'
            }}
          {%- endif -%}
        </a>
        <a
          href="{{ product.url }}"
          style="font-size:10px;line-height:1.25;font-weight:600;text-decoration:none;color:inherit;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:2.3em;"
        >
          {{ product.title }}
        </a>
        <span style="font-size:10px;color:rgba(0,0,0,0.6);">{{ product.price | money }}</span>
        {%- if product.available and product.has_only_default_variant -%}
          <button
            type="button"
            class="button cart-drawer-recommendations__add"
            data-variant-id="{{ product.selected_or_first_available_variant.id }}"
            style="font-size:10px;padding:2px 4px;width:100%;line-height:1.6;"
          >
            Add
          </button>
        {%- else -%}
          <a
            href="{{ product.url }}"
            class="button"
            style="font-size:10px;padding:2px 4px;width:100%;text-align:center;line-height:1.6;"
          >
            View
          </a>
        {%- endif -%}
      </div>
    {%- endfor -%}
  {%- endif -%}
</div>
