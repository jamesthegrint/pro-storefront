{% comment %}
  Rendered only via the Product Recommendations API (routes.product_recommendations_url
  with ?section_id=cart-drawer-recommendations&product_id=...). Not used as a standalone
  section anywhere in the theme — assets/cart-recommendations.js fetches this URL and
  extracts .cart-drawer-recommendations__results into the cart drawer placeholder.

  Vertical stack of cards for the left-hand "You may also like" rail
  (snippets/cart-drawer.liquid's .tg-drawer-recs-rail) — not a horizontal
  swipe row anymore, so no scroll-snap/width styling is needed here; each
  card just fills the rail's width.
{% endcomment %}
<div class="cart-drawer-recommendations__results" style="display:flex;flex-direction:column;gap:10px;">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    {%- for product in recommendations.products limit: 4 -%}
      <div
        class="cart-drawer-recommendations__item"
        style="display:flex;flex-direction:column;gap:4px;border:1px solid rgba(0,0,0,0.08);border-radius:8px;padding:8px;overflow:hidden;"
      >
        <a href="{{ product.url }}" style="display:block;width:64px;margin:0 auto;">
          {%- if product.featured_image -%}
            {{
              product.featured_image
              | image_url: width: 128
              | image_tag:
                loading: 'lazy',
                width: 64,
                height: 64,
                style: 'width:64px;height:64px;aspect-ratio:1/1;object-fit:cover;border-radius:6px;display:block;'
            }}
          {%- endif -%}
        </a>
        <a
          href="{{ product.url }}"
          style="font-size:12px;font-weight:600;text-decoration:none;color:inherit;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:2.6em;"
        >
          {{ product.title }}
        </a>
        <span style="font-size:12px;color:rgba(0,0,0,0.6);">{{ product.price | money }}</span>
        {%- if product.available and product.has_only_default_variant -%}
          <button
            type="button"
            class="button button--secondary cart-drawer-recommendations__add"
            data-variant-id="{{ product.selected_or_first_available_variant.id }}"
            style="font-size:12px;padding:4px 10px;width:100%;"
          >
            Add
          </button>
        {%- else -%}
          <a
            href="{{ product.url }}"
            class="button button--secondary"
            style="font-size:12px;padding:4px 10px;width:100%;text-align:center;"
          >
            View
          </a>
        {%- endif -%}
      </div>
    {%- endfor -%}
  {%- endif -%}
</div>
